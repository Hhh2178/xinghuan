[Unit]
Description=Xinghuan Canvas Next
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/apps/xinghuan-canvas-next/current
EnvironmentFile=/opt/apps/xinghuan-canvas-next/shared/canvas-next.env
ExecStart=/usr/bin/npm run start:single-port
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
