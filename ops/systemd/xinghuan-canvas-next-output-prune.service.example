[Unit]
Description=Xinghuan Canvas Next Output Material Pruner
After=network.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/apps/xinghuan-canvas-next/current
EnvironmentFile=/opt/apps/xinghuan-canvas-next/shared/canvas-next.env
ExecStart=/usr/bin/npm run cleanup:output-materials
NoNewPrivileges=true
PrivateTmp=true
