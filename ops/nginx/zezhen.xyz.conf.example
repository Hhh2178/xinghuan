    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name files.zezhen.online;
    include /etc/nginx/snippets/xinghuan-security-headers.conf;
    ssl_certificate /etc/letsencrypt/live/canvas.zezhen.online/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/canvas.zezhen.online/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;
    add_header Strict-Transport-Security "max-age=31536000" always;
    client_max_body_size 100m;
    if ($xinghuan_bad_bot) { return 403; }

    location /api/provider-files/gray/ {
        limit_req zone=xinghuan_files_ip burst=40 nodelay;
        proxy_pass http://127.0.0.1:18200;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_buffering off;
    }

    location /api/provider-files/production/ {
        limit_req zone=xinghuan_files_ip burst=40 nodelay;
        proxy_pass http://127.0.0.1:18100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_buffering off;
    }

    location / {
        return 404;
    }
}
