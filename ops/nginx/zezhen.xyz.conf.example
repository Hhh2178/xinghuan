# Managed for xinghuan canvas migration. HTTPS termination on target server.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    include /etc/nginx/snippets/xinghuan-security-headers.conf;
    return 444;
}

server {
    listen 80;
    listen [::]:80;
    server_name zezhen.xyz www.zezhen.xyz gray.zezhen.xyz files.zezhen.xyz canvas.zezhen.online canvas-next.zezhen.online files.zezhen.online;
    include /etc/nginx/snippets/xinghuan-security-headers.conf;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    server_name _;
    include /etc/nginx/snippets/xinghuan-security-headers.conf;
    ssl_certificate /etc/letsencrypt/live/canvas.zezhen.online/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/canvas.zezhen.online/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    return 444;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name canvas.zezhen.online;
    include /etc/nginx/snippets/xinghuan-security-headers.conf;
    ssl_certificate /etc/letsencrypt/live/canvas.zezhen.online/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/canvas.zezhen.online/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;
    add_header Strict-Transport-Security "max-age=31536000" always;
    client_max_body_size 100m;
    if ($xinghuan_bad_bot) { return 403; }

    location ~ ^/api/auth/(?:admin-)?login$ {
        limit_req zone=xinghuan_auth_ip burst=5 nodelay;
        proxy_pass http://127.0.0.1:18100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        proxy_buffering off;
    }

    location / {
        proxy_pass http://127.0.0.1:18100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_buffering off;
    }
}

