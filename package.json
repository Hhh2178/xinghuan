{
  "name": "xinghuan-canvas",
  "version": "0.1.0",
  "private": true,
  "description": "星幻无限画布 2.0 monorepo",
  "type": "module",
  "scripts": {
    "type-check": "npm run type-check --workspaces --if-present",
    "build": "npm run build -w @xinghuan/shared && npm run build -w @xinghuan/canvas-core && npm run build -w @xinghuan/model-core && npm run build -w @xinghuan/ui && npm run build -w @xinghuan/api && npm run build -w @xinghuan/worker && npm run build -w @xinghuan/web && npm run build -w @xinghuan/admin",
    "build:single-port": "npm run build -w @xinghuan/shared && npm run build -w @xinghuan/canvas-core && npm run build -w @xinghuan/model-core && npm run build -w @xinghuan/ui && npm run build -w @xinghuan/api && npm run build -w @xinghuan/worker && npm run build -w @xinghuan/web && npm run build -w @xinghuan/admin",
    "start:single-port": "node scripts/start-single-port.mjs",
    "start:worker": "npm run start -w @xinghuan/worker",
    "cleanup:output-materials": "node scripts/prune-old-output-materials.mjs --apply",
    "cleanup:output-materials:dry-run": "node scripts/prune-old-output-materials.mjs",
    "verify:local-acceptance-chain": "node scripts/verify-local-acceptance-chain.mjs",
    "verify:single-port": "node scripts/verify-single-port.mjs",
    "verify:xinghuan-entry-ui": "node scripts/verify-xinghuan-entry-ui.mjs",
    "verify:admin-interaction-guards": "node scripts/verify-admin-interaction-guards.mjs",
    "verify:admin-api-client-contract": "npx tsx scripts/verify-admin-api-client-contract.ts",
    "verify:admin-view-model-contract": "npx tsx scripts/verify-admin-view-model-contract.ts",
    "verify:admin-common-components-contract": "node scripts/verify-admin-common-components-contract.mjs",
    "verify:admin-readonly-panels-contract": "node scripts/verify-admin-readonly-panels-contract.mjs",
    "verify:admin-task-panel-contract": "node scripts/verify-admin-task-panel-contract.mjs",
    "verify:provider-file-access-contract": "npx tsx scripts/verify-provider-file-access-contract.ts",
    "verify:http-session-utils-contract": "npx tsx scripts/verify-http-session-utils-contract.ts",
    "verify:api-sanitizers-contract": "npx tsx scripts/verify-api-sanitizers-contract.ts",
    "verify:task-lifecycle-contract": "npx tsx scripts/verify-task-lifecycle-contract.ts",
    "verify:provider-model-catalog-contract": "npx tsx scripts/verify-provider-model-catalog-contract.ts",
    "verify:provider-response-parser-contract": "npx tsx scripts/verify-provider-response-parser-contract.ts",
    "verify:model-catalog": "node scripts/verify-model-catalog.mjs",
    "verify:grsai-draw": "npx tsx scripts/verify-grsai-image-adapter.ts && node scripts/verify-worker-grsai-contract.mjs",
    "verify:grsai-draw-gray": "node scripts/verify-grsai-draw-gray.mjs",
    "verify:external-image-proxy": "node scripts/verify-external-image-proxy.mjs",
    "verify:external-chat-proxy": "node scripts/verify-external-chat-proxy.mjs",
    "verify:external-video-proxy": "node scripts/verify-external-video-proxy.mjs",
    "verify:ai-watermark-api": "node scripts/verify-ai-watermark-api.mjs",
    "verify:canvas-resource-api": "node scripts/verify-canvas-resource-api.mjs",
    "verify:generic-node-catalog": "node scripts/verify-generic-node-catalog.mjs",
    "verify:canvas-node-render-smoke": "node scripts/verify-canvas-node-render-smoke.mjs",
    "verify:output-node-preview-layout": "npx tsx scripts/verify-output-node-preview-layout.mjs",
    "verify:task-payload-api": "node scripts/verify-task-payload-api.mjs",
    "verify:task-lifecycle": "node scripts/verify-task-lifecycle.mjs",
    "verify:runninghub-workflow-contract": "node scripts/verify-runninghub-workflow-contract.mjs",
    "verify:runninghub-workflow-api": "node scripts/verify-runninghub-workflow-api.mjs",
    "verify:node-acceptance-matrix": "node scripts/verify-node-acceptance-matrix.mjs",
    "verify:postgres-canvas-resource-contract": "node scripts/verify-postgres-canvas-resource-contract.mjs",
    "verify:worker-adapter-contract": "node scripts/verify-worker-adapter-contract.mjs",
    "verify:worker-grsai-contract": "node scripts/verify-worker-grsai-contract.mjs",
    "verify:worker-image-adapter": "node scripts/verify-worker-image-adapter.mjs",
    "verify:worker-output-materializer": "npx tsx scripts/verify-worker-output-materializer.ts",
    "verify:worker-output-materials": "node scripts/verify-worker-output-materials.mjs",
    "verify:output-material-prune": "npx tsx scripts/verify-output-material-prune.ts",
    "verify:worker-grsai-image-adapter": "node scripts/verify-worker-grsai-image-adapter.mjs",
    "verify:worker": "node scripts/verify-worker-queue.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:import-files": "node scripts/db-import-files.mjs",
    "dev:web": "npm run dev -w @xinghuan/web",
    "dev:admin": "npm run dev -w @xinghuan/admin",
    "dev:api": "npm run dev -w @xinghuan/api",
    "dev:worker": "npm run dev -w @xinghuan/worker"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.2.4",
    "typescript": "^5.9.3",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "lucide-react": "^0.555.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "tsx": "^4.20.6"
  }
}
