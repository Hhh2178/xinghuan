# 无限画布 2.0 本机开发环境变量模板
# 复制为 .env.local 后再填写真实值；.env.local 已被 .gitignore 忽略。
# 禁止把真实 API Key 提交到 Git、Markdown 文档、截图或聊天记录。

# GRSAI image provider
GRSAI_API_KEY=
GRSAI_BASE_URL=
GRSAI_DOC_URL=https://qmy27nhsd9.apifox.cn/452392911e0
GRSAI_ALT_DOC_URL=https://nkxx.grsai.com/zh/dashboard/documents/gpt-image
GRSAI_TEST_MODEL=gpt-image-2

# ToAPIs Grok video provider
TOAPIS_API_KEY=
TOAPIS_BASE_URL=
TOAPIS_DOC_URL=https://docs.toapis.com/docs/cn/api-reference/videos/grok-video/generation
TOAPIS_TEST_MODEL=grok-video-3

# Runtime
APP_ENV=local
APP_PUBLIC_URL=http://localhost:3000
